      */
-    if (!tls1_check_group_id(s, group_id, !s->server))
+    if (!mdg_tls12_bp320(s, pkey)
+        && !tls1_check_group_id(s, group_id, !s->server))
         return 0;
     /*
      * Special case for suite B. We *MUST* sign using SHA256+P-256 or
@@ -2749,7 +2790,8 @@
