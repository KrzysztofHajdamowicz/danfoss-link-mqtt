 #include <openssl/hmac.h>
 #include <openssl/core_names.h>
 #include <openssl/ocsp.h>
@@ -1831,6 +1832,45 @@
  * Check cert parameters compatible with extensions: currently just checks EC
  * certificates have compatible curves and compression.
  */
+
+/* Danfoss MDG compatibility: exact BrainpoolP320r1 group and valid EC key. */
+static int mdg_valid_bp320(EVP_PKEY *pkey)
+{
+    EC_KEY *key = NULL;
+    EC_GROUP *expected = NULL;
+    const EC_GROUP *actual;
+    const BIGNUM *a_cofactor, *e_cofactor;
+    int ok = 0;
+
+    if (pkey == NULL || !EVP_PKEY_is_a(pkey, "EC"))
+        return 0;
+    key = EVP_PKEY_get1_EC_KEY(pkey);
+    expected = EC_GROUP_new_by_curve_name(NID_brainpoolP320r1);
+    if (key == NULL || expected == NULL)
+        goto done;
+    actual = EC_KEY_get0_group(key);
+    if (actual == NULL || EC_GROUP_cmp(actual, expected, NULL) != 0)
+        goto done;
+    a_cofactor = EC_GROUP_get0_cofactor(actual);
+    e_cofactor = EC_GROUP_get0_cofactor(expected);
+    if (a_cofactor == NULL || e_cofactor == NULL
+        || BN_cmp(a_cofactor, e_cofactor) != 0)
+        goto done;
+    ok = EC_KEY_check_key(key) == 1;
+ done:
+    EC_GROUP_free(expected);
+    EC_KEY_free(key);
+    return ok;
+}
+
+/* TLS 1.2 only; known secure signing key, not an arbitrary curve exception. */
+static int mdg_tls12_bp320(const SSL_CONNECTION *s, EVP_PKEY *pkey)
+{
+    return s->version == TLS1_2_VERSION && !tls1_suiteb(s)
+        /* OpenSSL rounds 256..383-bit EC keys to 128 security bits. */
+        && EVP_PKEY_get_security_bits(pkey) >= 128 && mdg_valid_bp320(pkey);
+}
